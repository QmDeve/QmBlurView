<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/image" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <com.qmdeve.blurview.widget.SearchBar
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:blurRadius="20dp"
            app:cornerRadius="26dp"
            app:overlayColor="#90FFFFFF"
            app:searchBorderColor="#B3FFFFFF"
            app:searchBorderWidth="0.5dp"
            app:searchHint="Search"
            app:searchHintColor="#99000000"
            app:searchIconTint="#99000000"
            app:searchTextColor="@color/black"/>
    </LinearLayout>
</RelativeLayout>
