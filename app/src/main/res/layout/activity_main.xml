<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <com.qmdeve.blurview.widget.Button
            android:id="@+id/blurViewButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BlurView"
            android:textColor="@color/white"
            app:buttonCornerRadius="99dp"
            app:overlayColor="#0161F2" />

        <com.qmdeve.blurview.widget.Button
            android:id="@+id/blurIntensityButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blur Intensity Control"
            android:textColor="@color/white"
            app:buttonCornerRadius="99dp"
            app:overlayColor="#0161F2" />

        <com.qmdeve.blurview.widget.Button
            android:id="@+id/blurButtonButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BlurButton"
            android:textColor="@color/white"
            app:buttonCornerRadius="99dp"
            app:overlayColor="#0161F2" />

        <com.qmdeve.blurview.widget.Button
            android:id="@+id/progerssiveBlurButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progerssive Blur"
            android:textColor="@color/white"
            app:buttonCornerRadius="99dp"
            app:overlayColor="#0161F2" />

        <com.qmdeve.blurview.widget.Button
            android:id="@+id/titleBarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Titlebar"
            android:textColor="@color/white"
            app:buttonCornerRadius="99dp"
            app:overlayColor="#0161F2" />

        <com.qmdeve.blurview.widget.Button
            android:id="@+id/switchButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SwitchButton"
            android:textColor="@color/white"
            app:buttonCornerRadius="99dp"
            app:overlayColor="#0161F2" />

        <com.qmdeve.blurview.widget.Button
            android:id="@+id/floatingButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FloatingButton"
            android:textColor="@color/white"
            app:buttonCornerRadius="99dp"
            app:overlayColor="#0161F2" />

        <com.qmdeve.blurview.widget.Button
            android:id="@+id/bottomTabbarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BottomTabBar"
            android:textColor="@color/white"
            app:buttonCornerRadius="99dp"
            app:overlayColor="#0161F2" />

        <com.qmdeve.blurview.widget.Button
            android:id="@+id/cardViewButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CardView"
            android:textColor="@color/white"
            app:buttonCornerRadius="99dp"
            app:overlayColor="#0161F2" />

        <com.qmdeve.blurview.widget.Button
            android:id="@+id/searchBarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SearchBar"
            android:textColor="@color/white"
            app:buttonCornerRadius="99dp"
            app:overlayColor="#0161F2" />

        <com.qmdeve.blurview.widget.Button
            android:id="@+id/github"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/github"
            android:text="GitHub"
            android:textColor="@color/white"
            app:buttonCornerRadius="99dp"
            app:buttonIconSize="21dp"
            app:buttonIconTint="@color/white"
            app:overlayColor="@color/black" />
    </LinearLayout>
</ScrollView>